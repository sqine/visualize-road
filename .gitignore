# ──────────────────────────────────────────────────────────────────────
# 시스템 / 에디터
# ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ──────────────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ──────────────────────────────────────────────────────────────────────
# Streamlit secrets / 로그
# ──────────────────────────────────────────────────────────────────────
.streamlit/secrets.toml
.env
.env.*
!.env.example
*.log

# ──────────────────────────────────────────────────────────────────────
# Shapefile 원본 파일군 (전처리 입력만, 무조건 차단)
# 한 번이라도 commit 되면 GitHub 100MB 한도에 걸림
# ──────────────────────────────────────────────────────────────────────
*.shp
*.dbf
*.shx
*.prj
*.sbn
*.sbx
*.cpg
*.shp.xml

# 압축 파일은 원본 보관용 (런타임에는 풀린 파일을 씀)
*.zip

# ──────────────────────────────────────────────────────────────────────
# 데이터 — 화이트리스트 방식
# 기본: data/ 안의 모든 파일을 무시. 명시적으로 허용한 것만 commit.
# (data/* 하나만 써도 충분. data/**/* 추가하면 화이트리스트와 충돌 가능)
# ──────────────────────────────────────────────────────────────────────
data/*

# 가벼운 필수 데이터 (코드와 함께 배포되어야 함, 총 ~1.5MB)
# ⚠️ gitignore 는 줄 끝 주석을 지원하지 않는다 — 설명은 반드시 윗줄에 쓸 것
!data/.gitkeep
# 50KB  - 열선 설치 현황
!data/heating_2026.csv
# 564KB - 행정안전부 상습 결빙구간 (서울 필터됨)
!data/icing_zones.csv
# 36KB  - 자치구 25개 경계
!data/seoul_gu.geojson
# 756KB - 도로구간별 추정 유동인구 (기본 샘플)
!data/flpop.csv

# 🔥 열선 최적배치 페이지 (pages/) — 총 ~14.6MB
# 4.4MB - 서울 전역 링크: 열선·경사·표고·도로유형
!data/seoul_links.parquet
# 2.7MB - 링크 인접(끝점 5 m 스냅)
!data/seoul_edges.parquet
# 6.8MB - 링크 형상(지도)
!data/seoul_link_geom.parquet
# 420KB - 성북구 4개동 그래프(정밀 열선 매칭, 발표 재현)
!data/road_graph.json
# 108KB - 4개동 링크 중점 표고
!data/road_graph_nodes_elev.csv
# 51KB  - 성북구 행정동 경계
!data/seongbuk_dong.geojson
# 42KB  - 서대문구 행정동 경계
!data/seodaemun_dong.geojson
# 예산 × δ 이중 탐색 사전계산 결과 (scripts/run_sensitivity_grid.py, 약 0.4 MB)
!data/sensitivity_grid.parquet
!data/sensitivity_grid.json
!data/sensitivity_grid.html

# data 안의 하위 폴더는 무시 (slope_raw/, shp/ 등 전처리 입력)
data/*/

# 위 화이트리스트 외 모든 것은 무시됨. 주요 제외 항목:
#   ⛔ data/slope_raw/등고선 5000/N3L_F001.shp  (169 MB, 사용 안 함)
#   ⛔ data/서울시 경사도.zip                    (100 MB, 압축해제만 쓰임)
#   🟡 data/road_links.geojson                  (55 MB,  → 부트스트랩 다운로드)
#   🟡 data/seoul_roads_raw.geojson             (42 MB, 전처리 입력만)
#   🟡 data/shp/TBGIS_ROAD_LINK_FRM.shp         (22 MB, 전처리 입력만)
#   🟡 data/seoul_roads.geojson                 (18 MB, → 부트스트랩 다운로드)
#   🟡 data/slope_raw/  전체                    (180 MB, 전처리 입력만)
# (사용자가 캠퍼스에서 받아온 자신만의 flpop_*.csv 같은 변형은
#  필요시 사이드바 업로드로 사용 가능, 기본 data/flpop.csv 는 commit됨)

# 부트스트랩 임시 파일
data/_bootstrap_*
data/_upload_*

# 캠퍼스에서 받아오는 이미지/raster
data/foot_traffic_*.png
data/foot_traffic_*.tif
