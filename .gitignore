# ──────────────────────────────────────────────────────────────────────
# 시스템 / 에디터
# ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ──────────────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ──────────────────────────────────────────────────────────────────────
# Streamlit secrets / 로그
# ──────────────────────────────────────────────────────────────────────
.streamlit/secrets.toml
.env
*.log

# ──────────────────────────────────────────────────────────────────────
# Shapefile 원본 파일군 (전처리 입력만, 무조건 차단)
# 한 번이라도 commit 되면 GitHub 100MB 한도에 걸림
# ──────────────────────────────────────────────────────────────────────
*.shp
*.dbf
*.shx
*.prj
*.sbn
*.sbx
*.cpg
*.shp.xml

# 압축 파일은 원본 보관용 (런타임에는 풀린 파일을 씀)
*.zip

# ──────────────────────────────────────────────────────────────────────
# 데이터 — 화이트리스트 방식
# 기본: data/ 안의 모든 파일을 무시. 명시적으로 허용한 것만 commit.
# (data/* 하나만 써도 충분. data/**/* 추가하면 화이트리스트와 충돌 가능)
# ──────────────────────────────────────────────────────────────────────
data/*

# 가벼운 필수 데이터 (코드와 함께 배포되어야 함, 총 ~1.5MB)
!data/.gitkeep
!data/heating_2026.csv      # 50KB  - 열선 설치 현황
!data/icing_zones.csv       # 564KB - 행정안전부 상습 결빙구간 (서울 필터됨)
!data/seoul_gu.geojson      # 36KB  - 자치구 25개 경계
!data/flpop.csv             # 756KB - 도로구간별 추정 유동인구 (기본 샘플)

# data 안의 하위 폴더는 무시 (slope_raw/, shp/ 등 전처리 입력)
data/*/

# 위 화이트리스트 외 모든 것은 무시됨. 주요 제외 항목:
#   ⛔ data/slope_raw/등고선 5000/N3L_F001.shp  (169 MB, 사용 안 함)
#   ⛔ data/서울시 경사도.zip                    (100 MB, 압축해제만 쓰임)
#   🟡 data/road_links.geojson                  (55 MB,  → 부트스트랩 다운로드)
#   🟡 data/seoul_roads_raw.geojson             (42 MB, 전처리 입력만)
#   🟡 data/shp/TBGIS_ROAD_LINK_FRM.shp         (22 MB, 전처리 입력만)
#   🟡 data/seoul_roads.geojson                 (18 MB, → 부트스트랩 다운로드)
#   🟡 data/slope_raw/  전체                    (180 MB, 전처리 입력만)
# (사용자가 캠퍼스에서 받아온 자신만의 flpop_*.csv 같은 변형은
#  필요시 사이드바 업로드로 사용 가능, 기본 data/flpop.csv 는 commit됨)

# 부트스트랩 임시 파일
data/_bootstrap_*
data/_upload_*

# 캠퍼스에서 받아오는 이미지/raster
data/foot_traffic_*.png
data/foot_traffic_*.tif
